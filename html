<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Metas e Objetivos do Ano 🚀</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Partículas flutuantes de fundo -->
    <div class="bolhas">
        <div class="bolha"></div>
        <div class="bolha"></div>
        <div class="bolha"></div>
        <div class="bolha"></div>
    </div>

    <main class="container">
        <header class="header">
            <h1 class="titulo-animado">✨ Objetivos do Ano ✨</h1>
            <p>Transforme seus sonhos em conquistas diárias!</p>
        </header>

        <!-- Form de inserção -->
        <form id="form-objetivo" class="form-objetivo">
            <input 
                type="text" 
                id="input-objetivo" 
                placeholder="Qual seu próximo grande objetivo?" 
                required
                autocomplete="off"
            >
            <button type="submit" class="btn-adicionar">
                <span>Adicionar</span> 🚀
            </button>
        </form>

        <!-- Lista -->
        <section class="lista-objetivos" id="lista-objetivos">
            <!-- Inserido dinamicamente pelo JavaScript -->
        </section>
    </main>

    <script src="main.js"></script>
</body>
</html>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Poppins', sans-serif, system-ui;
}

body {
    background: #090a0f;
    color: #ffffff;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: 40px 20px;
    overflow-x: hidden;
    position: relative;
}

/* Fundo com esferas animadas */
.bolhas {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 0;
    pointer-events: none;
}

.bolha {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.6;
    animation: flutuar 8s infinite alternate ease-in-out;
}

.bolha:nth-child(1) {
    width: 300px;
    height: 300px;
    background: #ff007f;
    top: -50px;
    left: -50px;
}

.bolha:nth-child(2) {
    width: 250px;
    height: 250px;
    background: #7928ca;
    bottom: 50px;
    right: -50px;
    animation-delay: -2s;
}

.bolha:nth-child(3) {
    width: 200px;
    height: 200px;
    background: #00dfd8;
    bottom: -50px;
    left: 20%;
    animation-delay: -4s;
}

.bolha:nth-child(4) {
    width: 180px;
    height: 180px;
    background: #ff0080;
    top: 40%;
    right: 10%;
    animation-delay: -6s;
}

@keyframes flutuar {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(30px, 40px) scale(1.1); }
}

/* Container Principal */
.container {
    width: 100%;
    max-width: 650px;
    z-index: 1;
}

/* Título Arco-Íris Animado */
.header {
    text-align: center;
    margin-bottom: 30px;
}

.titulo-animado {
    font-size: 2.5rem;
    font-weight: 800;
    background: linear-gradient(90deg, #ff007f, #7928ca, #00dfd8, #ff007f);
    background-size: 300%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradienteTexto 5s linear infinite;
}

@keyframes gradienteTexto {
    0% { background-position: 0%; }
    100% { background-position: 300%; }
}

.header p {
    color: #a0aec0;
    margin-top: 5px;
}

/* Formulário Interativo */
.form-objetivo {
    display: flex;
    gap: 12px;
    margin-bottom: 35px;
}

.form-objetivo input {
    flex: 1;
    padding: 14px 20px;
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: 1rem;
    outline: none;
    transition: all 0.3s ease;
}

.form-objetivo input:focus {
    border-color: #00dfd8;
    box-shadow: 0 0 15px rgba(0, 223, 216, 0.4);
}

.btn-adicionar {
    padding: 14px 24px;
    border-radius: 12px;
    border: none;
    background: linear-gradient(135deg, #ff007f, #7928ca);
    color: white;
    font-weight: bold;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(255, 0, 127, 0.4);
}

.btn-adicionar:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 6px 20px rgba(255, 0, 127, 0.6);
}

.btn-adicionar:active {
    transform: translateY(0);
}

/* Cards de Objetivos */
.lista-objetivos {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.card-objetivo {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 22px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    animation: entrarCard 0.4s ease-out forwards;
    transition: all 0.3s ease;
}

.card-objetivo:hover {
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
}

@keyframes entrarCard {
